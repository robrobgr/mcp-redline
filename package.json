{
  "name": "mcp-redline",
  "version": "1.3.1",
  "description": "Deterministic local document citation and claim verification MCP server with explicit refusal",
  "main": "dist/src/index.js",
  "type": "module",
  "bin": {
    "mcp-redline": "./dist/src/index.js"
  },
  "files": [
    "dist/src",
    "corpus",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && npm run bundle:engine && npm run build:css",
    "build:css": "tailwindcss -i ./web/src/input.css -o ./web/dist/tailwind.css --minify",
    "bundle:engine": "esbuild src/browser.ts --bundle --format=iife --global-name=RedlineBundle --outfile=web/dist/engine.bundle.js",
    "start": "node dist/src/index.js",
    "test": "tsc && node --test dist/tests/*.test.js",
    "eval": "tsc && node scripts/eval.js",
    "bundle:web": "node scripts/build-web-data.js",
    "demo": "python3 -m http.server 3333 --directory web"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "verification",
    "grounding",
    "citation",
    "audit",
    "anti-hallucination"
  ],
  "author": "Robert Grabowski",
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.6.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "esbuild": "^0.28.2",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.3"
  }
}
