flowchart TD
  A["verify(claim)"] --> B["Extract terms, numbers, currencies, years"]
  B --> C["Find candidate sentences and table rows in the corpus"]
  C --> D["Score concept coverage (IDF, PL/EN lexicon)"]
  D --> E["Check numbers, currency, year, parties, negation within the clause"]
  E --> F["Apply source tier: Tier 1 > Tier 2 > Tier 3"]
  F --> G{"Verdict"}
  G --> H["GROUNDED + verbatim quote"]
  G --> I["CONTRADICTED + counter-quote"]
  G --> J["UNSUPPORTED + reason"]
