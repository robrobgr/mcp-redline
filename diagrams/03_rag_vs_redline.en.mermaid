flowchart TD
    classDef badPath fill:#450a0a,stroke:#ef4444,stroke-width:2px,color:#fee2e2;
    classDef goodPath fill:#064e3b,stroke:#10b981,stroke-width:2px,color:#ecfdf5;
    classDef common fill:#1e293b,stroke:#64748b,stroke-width:2px,color:#f8fafc;

    Question["Question / Doubt: Is 7.5% UK CPI price hike valid?"]:::common

    subgraph StandardRAG [" TRADITIONAL RAG (THE ILLUSION OF ACCURACY) "]
        Question --> RAGSearch["Vector similarity search (Top-K Chunks)"]:::badPath
        RAGSearch --> FoundMail["Matches sales email demanding 7.5% increase"]:::badPath
        FoundMail --> LLMSynth["LLM synthesizes response based on matching text"]:::badPath
        LLMSynth --> Hallucination["CONFIDENT HALLUCINATION:\n'Yes, pursuant to the Nov 12 email the rate increases by 7.5%'"]:::badPath
        Hallucination --> Risk["CONSEQUENCE: Executive blunder, wrongful payout, litigation exposure"]:::badPath
    end

    subgraph RedlineFlow [" MCP-REDLINE (DETERMINISTIC VERIFICATION) "]
        Question --> RedlineCall["Call verify(claim) tool via stdio"]:::goodPath
        RedlineCall --> ContractAudit["Deterministic contract hierarchy audit (Tier 1 vs Tier 3)"]:::goodPath
        ContractAudit --> NegationCatch["Detect stricken indexation clause in Section 8.2 MSA"]:::goodPath
        NegationCatch --> Refusal["EXPLICIT REFUSAL (CONTRADICTED):\n'Contradiction: Section 8.2 MSA bars indexation, letter is null and void'"]:::goodPath
        Refusal --> Safety["CONSEQUENCE: CISO compliance, complete defense against baseless claim"]:::goodPath
    end
