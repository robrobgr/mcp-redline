flowchart TD
    classDef clientStyle fill:#1e293b,stroke:#38bdf8,stroke-width:2px,color:#f8fafc;
    classDef mcpStyle fill:#0f172a,stroke:#818cf8,stroke-width:2px,color:#f8fafc;
    classDef noLlmStyle fill:#064e3b,stroke:#34d399,stroke-width:3px,color:#ecfdf5,stroke-dasharray: 4 2;
    classDef resultGrounded fill:#065f46,stroke:#10b981,stroke-width:2px,color:#ffffff;
    classDef resultRefused fill:#7f1d1d,stroke:#f87171,stroke-width:2px,color:#ffffff;

    UserPrompt["Zapytanie Użytkownika / Twierdzenie Biznesowe"]:::clientStyle --> Agent["Model LLM / Asystent (np. Claude, Gemini, Cursor)"]:::clientStyle
    Agent -- "tools/call: verify(claim)" --> MCPTransport["Transport stdio (Lokalny strumień procesu)"]:::mcpStyle

    subgraph DeterministicEngine [" SILNIK MCP-REDLINE — ZERO MODELI JĘZYKOWYCH (100% DETERMINIZM) "]
        MCPTransport --> ParseTokens["Ekstrakcja encji, liczb, dat i fraz kluczowych"]:::noLlmStyle
        ParseTokens --> CorpusLookup["Przeszukiwanie lokalnego korpusu (Authority Tiers)"]:::noLlmStyle
        CorpusLookup --> ConflictCheck{"Wykryto sprzeczność kontraktową lub wykreślenie klauzuli?"}:::noLlmStyle
        
        ConflictCheck -- "TAK (np. zakaz waloryzacji CPI, odrzucona kara)" --> UnsupportedReason["Generowanie twardego powodu odmowy z cytatem klauzuli"]:::noLlmStyle
        ConflictCheck -- "NIE" --> MatchMetrics{"Ścisłe dopasowanie liczb i pokrycie pojęciowe >= 55%?"}:::noLlmStyle
        
        MatchMetrics -- "TAK (Pełne poparcie w tekście)" --> GroundedBuild["Pobranie dosłownego cytatu i lokalizacji (plik, strona)"]:::noLlmStyle
        MatchMetrics -- "NIE (Brak dowodu / zmyłka)" --> MissingReason["Wskazanie braku wystarczającego oparcia w źródle"]:::noLlmStyle
    end

    GroundedBuild --> ResultGrounded["WERDYKT: GROUNDED\n(Status, Plik, Strona, Dosłowny Cytat)"]:::resultGrounded
    UnsupportedReason --> ResultUnsupported["WERDYKT: UNSUPPORTED\n(Twarda Odmowa + Wyjaśnienie Sprzeczności)"]:::resultRefused
    MissingReason --> ResultUnsupported

    ResultGrounded -- "Zwrot JSON-RPC przez stdout" --> Agent
    ResultUnsupported -- "Zwrot JSON-RPC przez stdout" --> Agent
    Agent --> FinalResponse["Pewna odpowiedź z dowodem LUB jednoznaczna odmowa konfabulacji"]:::clientStyle
