flowchart TD
  A["verify(twierdzenie)"] --> B["Wyodrębnienie pojęć, liczb, walut i lat"]
  B --> C["Wyszukanie zdań i wierszy tabel w korpusie"]
  C --> D["Ocena pokrycia pojęć (IDF, słownik PL/EN)"]
  D --> E["Weryfikacja liczb, walut, lat, stron i negacji w klauzuli"]
  E --> F["Zastosowanie rangi źródła: Tier 1 > Tier 2 > Tier 3"]
  F --> G{"Werdykt"}
  G --> H["GROUNDED + dosłowny cytat"]
  G --> I["CONTRADICTED + cytat sprzeczności"]
  G --> J["UNSUPPORTED + powód"]
