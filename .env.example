# Wzorzec konfiguracji środowiskowej mcp-redline
# Serwer z założenia działa lokalnie przez stdio i nie wymaga zewnętrznych kluczy API.
# Wszelkie opcjonalne zmienne konfiguracyjne (np. ścieżka do korpusu) definiuj poniżej:

MCP_REDLINE_CORPUS_DIR=./corpus
# Default language for verification explanations: en (default) or pl
MCP_REDLINE_LANG=en
